{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corypleasance-com",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "corypleasance.com", "custom_domain": true },
    { "pattern": "www.corypleasance.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
