---
import { getGithubContributions } from "@/utils/getGithubContributions";

type Props = { user: string };
const { user } = Astro.props;

const days = await getGithubContributions(user);
const MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ");

type Cell = { date: string; level: number; count: number } | null;
let weeks: Cell[][] = [];
let months: { col: number; label: string }[] = [];
let total = 0;

if (days) {
  total = days.reduce((n, d) => n + d.count, 0);
  // Pad the first week so each column runs Sunday to Saturday, as on GitHub.
  const lead = new Date(`${days[0].date}T00:00:00Z`).getUTCDay();
  const cells: Cell[] = [...Array(lead).fill(null), ...days];
  for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));

  let lastMonth = -1;
  weeks.forEach((week, col) => {
    const first = week.find(Boolean);
    if (!first) return;
    const d = new Date(`${first.date}T00:00:00Z`);
    const m = d.getUTCMonth();
    // Label a month at the first column it starts in, skipping a partial
    // first column so two labels never collide at the left edge.
    if (m !== lastMonth && !(col === 0 && d.getUTCDate() > 7)) {
      months.push({
        col,
        label: MONTHS[m],
      });
    }
    lastMonth = m;
  });
}

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
const label = (c: NonNullable<Cell>) =>
  `${c.count === 0 ? "No" : c.count} contribution${c.count === 1 ? "" : "s"} on ${fmt(c.date)}`;
---

{
  days && (
    <figure class="mt-6">
      <div
        class="heatmap"
        style={`--weeks: ${weeks.length}`}
        role="img"
        aria-label={`GitHub contribution heatmap: ${total} contributions in the past year`}
      >
        <div class="months" aria-hidden="true">
          {months.map(m => (
            <span style={`grid-column: ${m.col + 1}`}>{m.label}</span>
          ))}
        </div>
        <div class="grid-days" aria-hidden="true">
          {weeks.map(week =>
            Array.from({ length: 7 }, (_, i) => week[i] ?? null).map(c =>
              c ? (
                <span class={`l${c.level}`} title={label(c)} />
              ) : (
                <span class="empty" />
              )
            )
          )}
        </div>
      </div>
      <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-sm opacity-80">
        <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={`https://github.com/${user}`}
        >
          {total.toLocaleString("en-GB")} contributions in the past year
        </a>
        <span class="legend" aria-hidden="true">
          Less
          {[0, 1, 2, 3, 4].map(l => (
            <span class={`l${l}`} />
          ))}
          More
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .heatmap {
    --gap: 2px;
  }
  .months,
  .grid-days {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .months {
    margin-bottom: 4px;
    font-size: 0.7rem;
    line-height: 1;
    opacity: 0.7;
  }
  .months span {
    grid-row: 1;
    white-space: nowrap;
    overflow: visible;
    width: 0;
  }
  .grid-days {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--gap);
  }
  .grid-days span,
  .legend span {
    aspect-ratio: 1;
    border-radius: 2px;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .legend span {
    width: 10px;
    display: inline-block;
  }
  .l0 {
    background: var(--muted);
  }
  .l1 {
    background: color-mix(in srgb, var(--accent) 35%, var(--muted));
  }
  .l2 {
    background: color-mix(in srgb, var(--accent) 60%, var(--muted));
  }
  .l3 {
    background: color-mix(in srgb, var(--accent) 80%, var(--muted));
  }
  .l4 {
    background: var(--accent);
  }
  /* Keep months readable on narrow phones by labelling every other one. */
  @media (max-width: 480px) {
    .months span:nth-child(even) {
      visibility: hidden;
    }
  }
</style>
