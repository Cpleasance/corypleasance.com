---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, tags, repoUrl, readingTime, ...props } = data;
const estReadingTime = getReadingTime(body, readingTime);
const locale = Astro.currentLocale ?? "en";
---

<li
  class="post-card group relative my-4 flex cursor-pointer flex-col rounded-xl border border-border/80 bg-muted/20 p-5 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-muted/40 hover:shadow-md"
  data-tags={JSON.stringify(tags?.map(t => slugifyStr(t)) ?? [])}
  data-title={title.toLowerCase()}
  data-desc={description?.toLowerCase() ?? ""}
>
  <div class="flex h-full flex-col justify-between">
    <div>
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-accent inline-block text-lg font-semibold",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
          "before:absolute before:inset-0 before:z-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>{title}</Heading>
      </a>
      <div class="text-muted-foreground pointer-events-none relative z-10 my-1.5 flex flex-wrap items-center gap-x-2 text-xs sm:text-sm">
        <Datetime {...props} />
        <span aria-hidden="true">·</span>
        <span>{estReadingTime}</span>
        {repoUrl && (
          <>
            <span aria-hidden="true">·</span>
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent pointer-events-auto inline-flex items-center gap-0.5 underline decoration-dashed underline-offset-2"
            >
              <span>Code</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3.5 opacity-80"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          </>
        )}
      </div>
      <p class="pointer-events-none mt-2 text-sm leading-relaxed opacity-85">
        {description}
      </p>
    </div>
    {tags && tags.length > 0 && (
      <ul class="relative z-10 mt-4 flex flex-wrap gap-1.5 pt-1">
        {tags.map(tag => (
          <li>
            <a
              href={`${getRelativeLocaleUrl(locale, "posts")}?filter=${slugifyStr(tag)}`}
              data-tag-slug={slugifyStr(tag)}
              class="tag-link border-border bg-accent/10 text-accent hover:bg-accent/20 rounded-md border border-accent/20 px-2 py-0.5 font-mono text-xs transition-colors"
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
