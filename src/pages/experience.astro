---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

type Job = {
  role: string;
  org: string;
  when: string;
  tag?: string;
  note?: string;
};

const experience: Job[] = [
  {
    role: "Technology Developer Summer Intern",
    org: "Barclays UK",
    when: "Summer 2027",
    tag: "Incoming",
    note: "Offered after the Barclays Discovery Programme (April 2026).",
  },
  {
    role: "Demonstrator, Data Structures and Algorithms (CSCU9A3)",
    org: "University of Stirling",
    when: "Sep 2026–now",
  },
  {
    role: "IT Assistant",
    org: "University of Stirling",
    when: "Sep 2026–now",
  },
  {
    role: "Helping with LLM security research",
    org: "University of Stirling",
    when: "2024–now",
    note: "Helping build an automated system that tests how robust LLMs are. Paper in progress.",
  },
  {
    role: "Technology, Data & Innovation work experience",
    org: "Deutsche Bank",
    when: "2025",
    note: "Time with the algorithmic trading team and with the GenAI and AI Architecture teams on LLM robustness in regulated environments.",
  },
];

const certifications = [
  "Anthropic: Building with the Claude API · Model Context Protocol: Advanced Topics (2026)",
  "Python Institute: PCPP, Programming with Python Professional (2025)",
  "IBM: Advanced Deep Learning Specialist, plus three ML/DL certificates (2025)",
  "Google: Foundations of Data Science (2025)",
];

const tools = [
  { group: "Languages", items: ["Python", "Java", "Rust", "SQL"] },
  {
    group: "ML",
    items: ["PyTorch", "Hugging Face", "scikit-learn", "LightGBM", "CatBoost"],
  },
  {
    group: "Infrastructure",
    items: ["Linux", "Docker", "CUDA", "SLURM", "vLLM", "Ollama"],
  },
];
---

<Layout
  title={`Experience | ${config.site.title}`}
  ogImage="/og/experience.png"
  description="Research, work experience and tools: Cory Pleasance, Data Science & AI at the University of Stirling."
>
  <Header />

  <main id="main-content" class="app-layout pt-8 pb-12">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold sm:text-4xl">Experience</h1>
      <p class="text-sm opacity-75 sm:text-base">
        Industry internships, academic roles, research projects, and technical
        skills.
      </p>
    </div>

    <!-- Experience Timeline -->
    <div class="relative border-s-2 border-border/80 ms-2 sm:ms-3 mt-10 ps-6 sm:ps-8 space-y-8">
      {experience.map(e => (
        <div class="relative group">
          <!-- Timeline Node Dot -->
          <div class="absolute -start-[31px] sm:-start-[39px] mt-1.5 size-3.5 rounded-full border-2 border-background bg-accent group-hover:scale-125 transition-transform"></div>

          <div class="border-border/80 hover:border-accent bg-muted/20 hover:bg-muted/40 rounded-xl border p-5 transition-all shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-accent font-mono text-xs font-semibold sm:text-sm">
                {e.when}
              </span>
              {e.tag && (
                <span class="border border-accent/30 bg-accent/15 text-accent rounded-full px-2.5 py-0.5 font-mono text-xs font-semibold">
                  {e.tag}
                </span>
              )}
            </div>

            <h2 class="mt-2 text-lg font-semibold text-foreground">{e.role}</h2>
            <p class="text-sm font-medium opacity-80 mt-0.5">{e.org}</p>

            {e.note && (
              <p class="mt-3 text-sm leading-relaxed opacity-75 border-t border-border/50 pt-2.5">
                {e.note}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Tools Section -->
    <section id="tools" class="border-border mt-14 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Tools & Technologies</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {tools.map(t => (
          <div class="border-border/80 bg-muted/20 rounded-xl border p-5 flex flex-col justify-between">
            <div>
              <h3 class="text-accent font-mono text-xs uppercase tracking-wider font-semibold border-b border-border/50 pb-2">
                {t.group}
              </h3>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {t.items.map(i => (
                  <span class="border-border bg-background/80 hover:border-accent/50 rounded-md border px-2 py-1 font-mono text-xs transition-colors">
                    {i}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications Section -->
    <section id="certifications" class="border-border mt-14 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Certifications</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {certifications.map(c => {
          const colonIdx = c.indexOf(":");
          const issuer = colonIdx > -1 ? c.slice(0, colonIdx) : "Certification";
          const title = colonIdx > -1 ? c.slice(colonIdx + 1).trim() : c;
          return (
            <div class="border-border/80 bg-muted/20 hover:border-accent/60 rounded-xl border p-4 flex items-start gap-3 transition-colors">
              <div class="mt-1 size-2 rounded-full bg-accent shrink-0" />
              <div>
                <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">
                  {issuer}
                </span>
                <p class="text-sm font-medium mt-0.5 leading-snug opacity-90">
                  {title}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
