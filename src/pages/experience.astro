---

<Layout
  title={`Experience | ${config.site.title}`}
  ogImage="/og/experience.png"
  description="Work experience, research, academic representation, technical tools, and verified certifications: Cory Pleasance."
>
  <Header />

  <main id="main-content" class="app-layout pt-8 pb-12">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold sm:text-4xl">Experience</h1>
      <p class="text-sm opacity-75 sm:text-base">
        Industry internships, academic roles, research projects, and technical
        skills.
      </p>
    </div>

    <!-- Experience Timeline -->
    <div class="relative border-s-2 border-border/80 ms-2 sm:ms-3 mt-10 ps-6 sm:ps-8 space-y-8">
      {experience.map(e => (
        <div class="relative group">
          <!-- Timeline Node Dot -->
          <div class="absolute -start-[31px] sm:-start-[39px] mt-1.5 size-3.5 rounded-full border-2 border-background bg-accent group-hover:scale-125 transition-transform"></div>

          <div class="border-border/80 hover:border-accent bg-muted/20 hover:bg-muted/40 rounded-xl border p-5 transition-all shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-accent font-mono text-xs font-semibold sm:text-sm">
                  {e.when}
                </span>
                {e.location && (
                  <span class="text-xs opacity-60 font-mono">
                    · {e.location}
                  </span>
                )}
              </div>
              {e.tag && (
                <span class="border border-accent/30 bg-accent/15 text-accent rounded-full px-2.5 py-0.5 font-mono text-xs font-semibold">
                  {e.tag}
                </span>
              )}
            </div>

            <h2 class="mt-2 text-lg font-semibold text-foreground">{e.role}</h2>
            <p class="text-sm font-medium opacity-80 mt-0.5">{e.org}</p>

            {e.note && (
              <p class="mt-3 text-sm leading-relaxed opacity-75 border-t border-border/50 pt-2.5">
                {e.note}
              </p>
            )}

            {e.bullets && e.bullets.length > 0 && (
              <ul class="mt-3 list-disc space-y-1.5 ps-5 text-sm leading-relaxed opacity-80 marker:text-accent border-t border-border/50 pt-3">
                {e.bullets.map(b => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Academic Representation & Volunteering -->
    <section id="volunteering" class="border-border mt-14 border-t pt-10">
      <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-wide">
          Academic Representation & Volunteering
        </h2>
        <p class="text-sm opacity-75">
          Elected student representation and academic cohort advocacy at the
          University of Stirling.
        </p>
      </div>

      <div class="mt-6 space-y-4">
        {volunteering.map(v => (
          <div class="border-border/80 bg-muted/20 hover:bg-muted/30 rounded-xl border p-5 transition-all shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-accent font-mono text-xs font-semibold sm:text-sm">
                {v.when}
              </span>
              <span class="border border-border/70 bg-muted/40 text-foreground/80 rounded-md px-2 py-0.5 font-mono text-xs">
                {v.org}
              </span>
            </div>
            <h3 class="mt-2 text-base sm:text-lg font-semibold text-foreground">
              {v.role}
            </h3>
            {v.note && (
              <p class="mt-2 text-sm leading-relaxed opacity-75 border-t border-border/50 pt-2">
                {v.note}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Tools Section -->
    <section id="tools" class="border-border mt-14 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Tools & Technologies</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {tools.map(t => (
          <div class="border-border/80 bg-muted/20 rounded-xl border p-5 flex flex-col justify-between">
            <div>
              <h3 class="text-accent font-mono text-xs uppercase tracking-wider font-semibold border-b border-border/50 pb-2">
                {t.group}
              </h3>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {t.items.map(i => (
                  <span class="border-border bg-background/80 hover:border-accent/50 rounded-md border px-2 py-1 font-mono text-xs transition-colors">
                    {i}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Licenses & Certifications Section -->
    <section id="certifications" class="border-border mt-14 border-t pt-10">
      <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-wide">
          Licenses & Certifications
        </h2>
        <p class="text-sm opacity-75">
          Verified professional certifications across artificial intelligence,
          systems, and data science.
        </p>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {certifications.map(c => (
          <div class="border-border/80 bg-muted/20 hover:border-accent/60 rounded-xl border p-4 flex flex-col justify-between transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">
                  {c.issuer}
                </span>
                <span class="text-xs font-mono opacity-60">{c.date}</span>
              </div>
              <h3 class="text-sm font-semibold mt-1 leading-snug text-foreground">
                {c.name}
              </h3>
            </div>

            {(c.credentialId || (c.skills && c.skills.length > 0)) && (
              <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-border/40 pt-2 text-xs font-mono">
                {c.credentialId && (
                  <span class="text-[11px] opacity-70">
                    ID: <code class="text-foreground/90">{c.credentialId}</code>
                  </span>
                )}
                {c.skills?.map(skill => (
                  <span class="rounded bg-muted/50 border border-border/60 px-1.5 py-0.5 text-[10px] text-accent">
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
