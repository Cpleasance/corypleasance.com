---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

// The intro paragraphs live in src/content/pages/about.md; everything else is below.
const { Content } = await render(about);

const link = "hover:text-accent underline decoration-dashed underline-offset-4";

const now = [
  {
    title: "Helping with LLM red-teaming research",
    body: "At Stirling, I'm helping build an automated system for red-teaming language models and measuring how well they hold up. A paper is in progress.",
  },
  {
    title: "Competitions",
    body: "A bronze medal in Kaggle's AI Agent Security competition (top 7% of 4,186 teams), a paper-track entry in Kaggle's Gemma 4 agent competition, and a live model in Numerai's tournament.",
  },
  {
    title: "Barclays, summer 2027",
    body: "I'm joining Barclays UK as a Technology Developer intern, after taking part in the Barclays Discovery Programme in April 2026.",
  },
];

const uni = [
  "On track for a First: I finished Year 2 with an 82.2% average.",
  "Demonstrator for Data Structures and Algorithms, and IT assistant for the university.",
  "Was the Computer Science course representative in Year 2, speaking for 80+ students.",
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage ?? "/og/about.png"}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout pb-12">
    <section class="pt-8">
      <h1 class="text-3xl font-bold sm:text-4xl">About</h1>

      <div class="mt-8 grid gap-8 md:grid-cols-[1fr_260px] lg:grid-cols-[1fr_300px] items-start">
        <div class="space-y-4 leading-relaxed text-base sm:text-lg opacity-90">
          <Content />
        </div>
        <div class="order-first md:order-last">
          <figure class="overflow-hidden rounded-xl border border-border/80 bg-muted/20 shadow-xs">
            <picture>
              <source
                srcset={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cory.webp`}
                type="image/webp"
              />
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cory.jpg`}
                alt="Cory Pleasance on a hill summit in Scotland"
                width="840"
                height="1117"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </picture>
            <figcaption class="p-2.5 text-center text-xs opacity-70 border-t border-border/50">
              In the Ochil Hills above Stirling
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="now" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">What I'm working on</h2>
      <ul class="mt-6 space-y-6">
        {now.map(n => (
          <li>
            <h3 class="font-semibold text-foreground">{n.title}</h3>
            <p class="mt-1 text-sm sm:text-base leading-relaxed opacity-80">
              {n.body}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="university" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">At university</h2>
      <ul class="mt-6 list-disc space-y-2 ps-5 marker:text-accent">
        {uni.map(u => (
          <li class="leading-relaxed opacity-85 text-sm sm:text-base">{u}</li>
        ))}
      </ul>
    </section>

    <section id="contact" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Contact</h2>
      <p class="mt-4">
        Find me on{" "}
        <a class={link} href="https://github.com/Cpleasance">
          GitHub
        </a>
        ,{" "}
        <a class={link} href="https://www.kaggle.com/cpleasance">
          Kaggle
        </a>{" "}
        and{" "}
        <a class={link} href="https://pypi.org/user/CXP/">
          PyPI
        </a>
        , connect on{" "}
        <a
          class={link}
          href="https://www.linkedin.com/in/cory-pleasance-b99b80205/"
        >
          LinkedIn
        </a>
        , or email{" "}
        <a class={link} href="mailto:me@corypleasance.com">
          me@corypleasance.com
        </a>
        .
      </p>
    </section>
  </main>

  <Footer />
</Layout>
