---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

// The intro paragraphs live in src/content/pages/about.md; everything else is below.
const { Content } = await render(about);

const link = "hover:text-accent underline decoration-dashed underline-offset-4";

const now = [
  {
    title: "Helping with LLM red-teaming research",
    body: "At Stirling, I'm helping build an automated system for red-teaming language models and measuring how well they hold up. A paper is in progress.",
  },
  {
    title: "Competitions",
    body: "A bronze medal in Kaggle's AI Agent Security competition (top 7% of 4,186 teams), a paper-track entry in Kaggle's Gemma 4 agent competition, and a live model in Numerai's tournament.",
  },
  {
    title: "Barclays, summer 2027",
    body: "I'm joining Barclays UK as a Technology Developer intern, after taking part in the Barclays Discovery Programme in April 2026.",
  },
];

const uni = [
  "On track for a First: I finished Year 2 with an 82.2% average.",
  "Demonstrator for Data Structures and Algorithms, and IT assistant for the university.",
  "Was the Computer Science course representative in Year 2, speaking for 80+ students.",
];

const interests = [
  {
    title: "Running",
    tag: "Outdoors",
    description:
      "Trying to get into ultramarathon running (let's see how that goes), mostly up in the Ochils.",
  },
  {
    title: "3D Printing",
    tag: "Maker",
    description:
      "Printing practical things, like a custom wallet with an embedded NFC chip for the gym.",
  },
  {
    title: "Italian Cooking",
    tag: "Food",
    description: "Cooking at home, especially Italian food.",
  },
];

const visitedCountries = [
  { name: "Australia", code: "AUS" },
  { name: "Belgium", code: "BEL" },
  { name: "Egypt", code: "EGY" },
  { name: "Finland", code: "FIN" },
  { name: "France", code: "FRA" },
  { name: "Greece", code: "GRC" },
  { name: "India", code: "IND" },
  { name: "Italy", code: "ITA" },
  { name: "Lithuania", code: "LTU" },
  { name: "Malaysia", code: "MYS" },
  { name: "Maldives", code: "MDV" },
  { name: "Malta", code: "MLT" },
  { name: "Netherlands", code: "NLD" },
  { name: "Oman", code: "OMN" },
  { name: "Qatar", code: "QAT" },
  { name: "Saudi Arabia", code: "SAU" },
  { name: "Singapore", code: "SGP" },
  { name: "Spain", code: "ESP" },
  { name: "Switzerland", code: "CHE" },
  { name: "Tanzania", code: "TZA" },
  { name: "Thailand", code: "THA" },
  { name: "United Kingdom", code: "GBR" },
  { name: "Vatican City", code: "VAT" },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage ?? "/og/about.png"}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout pb-12">
    <section class="pt-8">
      <h1 class="text-3xl font-bold sm:text-4xl">About</h1>

      <div class="mt-8 grid gap-8 md:grid-cols-[1fr_260px] lg:grid-cols-[1fr_300px] items-start">
        <div class="space-y-4 leading-relaxed text-base sm:text-lg opacity-90">
          <Content />
        </div>
        <div class="order-first md:order-last">
          <figure class="overflow-hidden rounded-xl border border-border/80 bg-muted/20 shadow-xs">
            <picture>
              <source
                srcset={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cory.webp`}
                type="image/webp"
              />
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}cory.jpg`}
                alt="Cory Pleasance on a hill summit in Scotland"
                width="840"
                height="1117"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </picture>
            <figcaption class="p-2.5 text-center text-xs opacity-70 border-t border-border/50">
              In the Ochil Hills above Stirling
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Personal Interests / Beyond the screen -->
    <section id="interests" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Beyond the screen</h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {interests.map(item => (
          <div class="border-border/80 bg-muted/20 hover:border-accent hover:bg-muted/35 hover:-translate-y-0.5 rounded-xl border p-5 flex flex-col justify-between transition-all duration-200 shadow-xs hover:shadow-md">
            <div>
              <span class="border border-border/70 bg-muted/40 text-accent font-mono text-[11px] font-semibold rounded-md px-2 py-0.5">
                {item.tag}
              </span>
              <h3 class="mt-2.5 font-semibold text-foreground text-base leading-snug">
                {item.title}
              </h3>
              <p class="mt-1.5 text-xs sm:text-sm leading-relaxed opacity-80">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Countries Visited -->
      <div class="mt-8 pt-6 border-t border-border/50">
        <p class="text-xs sm:text-sm opacity-75 mb-3">
          I love travelling, see where I have been so far:
        </p>

        <details class="group rounded-xl border border-border/80 bg-muted/20 p-4 transition-all hover:border-accent/60">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-medium select-none list-none gap-2">
            <span class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-accent shrink-0"></span>
              <span class="font-semibold text-foreground">
                23 countries visited
              </span>
            </span>
            <span class="flex items-center gap-1 text-xs font-mono text-accent">
              <span class="group-open:hidden">Show</span>
              <span class="hidden group-open:inline">Hide</span>
              <span class="transition-transform duration-200 group-open:rotate-180">
                ▾
              </span>
            </span>
          </summary>

          <div class="mt-4 pt-3 border-t border-border/50 text-sm">
            <div class="flex flex-wrap gap-1.5">
              {visitedCountries.map(c => (
                <span class="rounded-md border border-border/70 bg-background/80 hover:border-accent/60 px-2 py-0.5 text-xs font-mono transition-colors">
                  {c.name}{" "}
                  <span class="opacity-50 text-[10px]">{c.code}</span>
                </span>
              ))}
            </div>
          </div>
        </details>
      </div>
    </section>

    <section id="now" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">What I'm working on</h2>
      <ul class="mt-6 space-y-6">
        {now.map(n => (
          <li>
            <h3 class="font-semibold text-foreground">{n.title}</h3>
            <p class="mt-1 text-sm sm:text-base leading-relaxed opacity-80">
              {n.body}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section id="university" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">At university</h2>
      <ul class="mt-6 list-disc space-y-2 ps-5 marker:text-accent">
        {uni.map(u => (
          <li class="leading-relaxed opacity-85 text-sm sm:text-base">{u}</li>
        ))}
      </ul>
    </section>

    <section id="contact" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Contact</h2>
      <p class="mt-4">
        Find me on{" "}
        <a class={link} href="https://github.com/Cpleasance">
          GitHub
        </a>
        ,{" "}
        <a class={link} href="https://www.kaggle.com/cpleasance">
          Kaggle
        </a>{" "}
        and{" "}
        <a class={link} href="https://pypi.org/user/CXP/">
          PyPI
        </a>
        , connect on{" "}
        <a
          class={link}
          href="https://www.linkedin.com/in/cory-pleasance-b99b80205/"
        >
          LinkedIn
        </a>
        , or email{" "}
        <a class={link} href="mailto:me@corypleasance.com">
          me@corypleasance.com
        </a>
        .
      </p>
    </section>
  </main>

  <Footer />
</Layout>
