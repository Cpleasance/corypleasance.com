---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

// The intro paragraph lives in src/content/pages/about.md; everything else is below.
const { Content } = await render(about);

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

type Job = {
  role: string;
  org: string;
  when: string;
  tag?: string;
  note?: string;
};

const experience: Job[] = [
  {
    role: "Demonstrator, Data Structures and Algorithms (CSCU9A3)",
    org: "University of Stirling",
    when: "Now",
  },
  {
    role: "Technology Developer Summer Intern",
    org: "Barclays UK",
    when: "Summer 2027",
    tag: "Incoming",
  },
  {
    role: "Technology, Data & Innovation work experience",
    org: "Deutsche Bank",
    when: "2025",
    note: "Time with the algorithmic trading team and with the GenAI and AI Architecture teams on LLM robustness in regulated environments.",
  },
];

const tools = [
  { group: "Languages", items: ["Python", "Java", "Rust", "SQL"] },
  {
    group: "ML",
    items: ["PyTorch", "Hugging Face", "scikit-learn", "LightGBM", "CatBoost"],
  },
  {
    group: "Infrastructure",
    items: ["Linux", "Docker", "CUDA", "SLURM", "vLLM", "Ollama"],
  },
];

const link = "hover:text-accent underline decoration-dashed underline-offset-4";
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <section class="border-border border-b pb-8">
      <div class="mb-6 flex items-center gap-4 sm:gap-6">
        <img
          src={`${base}avatar.png`}
          alt="Pixel-art portrait of Cory at a computer"
          width="96"
          height="96"
          class="size-16 shrink-0 rounded-lg sm:size-24"
          style="image-rendering: pixelated"
        />
        <div>
          <h1 class="text-3xl font-bold sm:text-4xl">About</h1>
          <p class="mt-2 text-sm opacity-75 sm:text-base">
            Data Science &amp; AI · University of Stirling · 2024–2028
          </p>
        </div>
      </div>
      <div class="leading-relaxed"><Content /></div>
    </section>

    <section id="research" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Research</h2>
      <div class="border-border mt-6 rounded-lg border p-4">
        <p class="text-accent text-sm">University of Stirling · 2024–present</p>
        <h3 class="mt-1 font-semibold">LLM security</h3>
        <p class="mt-2 opacity-80">
          I am currently building an automated system for testing the robustness
          of LLMs through a collection of LLMs that can utilise multiple
          different strategies.
        </p>
      </div>
    </section>

    <section id="experience" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Experience</h2>
      <ol class="mt-6 space-y-6">
        {
          experience.map(e => (
            <li class="grid gap-x-6 sm:grid-cols-[8rem_1fr]">
              <p class="text-accent text-sm sm:pt-0.5">{e.when}</p>
              <div>
                <h3 class="font-semibold">{e.role}</h3>
                <p class="text-sm opacity-75">
                  {e.org}
                  {e.tag && ` · ${e.tag}`}
                </p>
                {e.note && <p class="mt-1 text-sm opacity-80">{e.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="tools" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Tools I use</h2>
      <dl class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-[8rem_1fr]">
        {
          tools.map(t => (
            <>
              <dt class="text-accent font-semibold">{t.group}</dt>
              <dd class="mb-3 flex flex-wrap gap-2 sm:mb-0">
                {t.items.map(i => (
                  <span class="border-border rounded-md border px-2 py-0.5 text-sm">
                    {i}
                  </span>
                ))}
              </dd>
            </>
          ))
        }
      </dl>
    </section>

    <section id="contact" class="py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Contact</h2>
      <p class="mt-4">
        Find me on <a class={link} href="https://github.com/Cpleasance"
          >GitHub</a
        > and <a class={link} href="https://www.kaggle.com/cpleasance">Kaggle</a
        >, connect on <a
          class={link}
          href="https://www.linkedin.com/in/cory-pleasance-b99b80205/"
          >LinkedIn</a
        >, or email <a class={link} href="mailto:me@corypleasance.com"
          >me@corypleasance.com</a
        >.
      </p>
      <div class="mt-4"><Socials /></div>
    </section>
  </main>

  <Footer />
</Layout>
