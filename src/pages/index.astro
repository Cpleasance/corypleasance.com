---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
// Featured posts first, then the rest, as one list.
const homePosts = [
  ...sortedPosts.filter(({ data }) => data.featured),
  ...sortedPosts.filter(({ data }) => !data.featured),
].slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");

const link = "hover:text-accent underline decoration-dashed underline-offset-4";

// The bronze-medal project is the featured post, so it isn't repeated here.
const work = [
  {
    label: "Kaggle · Gemma 4 paper track",
    title: "It Shouldn't Matter What Task Is Given",
    blurb: "A held-out task pool and a pre-flight suite for evaluating agents.",
    href: "https://www.kaggle.com/competitions/gemma-4-developer-agent-paper/writeups/new-writeup-1794239936181",
    tags: ["LLM Evaluation", "Benchmarking", "Python"],
    cta: "Kaggle Write-up ↗",
  },
  {
    label: "Python · MCP server",
    title: "Token Runway",
    blurb:
      "Gives AI coding agents a live view of their token and rate-limit usage, so they can pick a cheaper approach before they hit a limit.",
    href: "https://github.com/Cpleasance/token-runway",
    tags: ["MCP", "Rate-Limiting", "Python"],
    cta: "GitHub ↗",
  },
  {
    label: "Rust · Systems & GUI",
    title: "Wake Workstation",
    blurb:
      "Cross-platform desktop GUI + CLI automating Wake-on-LAN, ICMP reachability checks, and Moonlight game streaming.",
    href: "https://github.com/Cpleasance/wake-workstation",
    tags: ["Rust", "egui", "Networking", "Moonlight"],
    cta: "GitHub ↗",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-12"
  >
    <section id="hero" class="pt-8 sm:pt-12">
      <div class="flex items-center gap-4 sm:gap-6">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}avatar.png`}
          alt="Pixel-art portrait of Cory at a computer"
          width="96"
          height="96"
          class="size-16 shrink-0 rounded-lg sm:size-24"
          style="image-rendering: pixelated"
        />
        <div>
          <h1 class="text-3xl font-bold sm:text-5xl">Hey there, I'm Cory</h1>
          <p class="mt-2 text-sm opacity-75 sm:text-base">
            Third-year Data Science &amp; AI student, University of Stirling
          </p>
          <div class="mt-3.5 flex flex-wrap gap-2 text-xs">
            <span class="border-accent/30 bg-accent/10 text-accent inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-medium">
              <span class="bg-accent size-1.5 rounded-full"></span>
              Incoming Tech Developer Intern @ Barclays UK (Summer 2027)
            </span>
            <span class="border-accent/30 bg-accent/10 text-accent inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-medium">
              <span>🥉</span>
              Kaggle Top 7% · AI Agent Security
            </span>
          </div>
        </div>
      </div>

      <p class="mt-8 leading-relaxed">
        I write here about AI security, agent evaluation, and systems
        engineering. Right now I'm building automated systems that red-team
        language models, and measuring how well the models hold up.
      </p>

      <p class="mt-4">
        <a class={link} href={getRelativeLocaleUrl(locale, "about")}>
          More about me
        </a>
      </p>
    </section>

    {homePosts.length > 0 && (
      <section id="posts" class="border-border mt-12 border-t pt-10">
        <h2 class="text-xl font-semibold tracking-wide">Posts</h2>
        <ul>
          {homePosts.map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
        {sortedPosts.length > homePosts.length && (
          <p class="mt-2">
            <a class={link} href={getRelativeLocaleUrl(locale, "posts")}>
              All posts
            </a>
          </p>
        )}
      </section>
    )}

    <section id="work" class="border-border mt-12 border-t pt-10">
      <h2 class="text-xl font-semibold tracking-wide">Selected work</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {work.map(item => (
          <li>
            <a
              href={item.href}
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={
                item.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="border-border hover:border-accent group flex h-full flex-col justify-between rounded-lg border p-4 transition-colors"
            >
              <div>
                <div class="flex items-center justify-between text-xs opacity-70">
                  <span>{item.label}</span>
                  <span class="text-accent font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    {item.cta}
                  </span>
                </div>
                <h3 class="group-hover:text-accent mt-2 font-semibold">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm opacity-80">{item.blurb}</p>
              </div>
              <ul class="mt-4 flex flex-wrap gap-1.5 pt-2">
                {item.tags.map(tag => (
                  <li class="border-border bg-muted/40 rounded px-1.5 py-0.5 font-mono text-[11px] opacity-70">
                    {tag}
                  </li>
                ))}
              </ul>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a class={link} href={getRelativeLocaleUrl(locale, "projects")}>
          All projects
        </a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
