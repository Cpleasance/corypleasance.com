---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const work = [
  {
    label: "Kaggle · Bronze medal, top 7%",
    title: "AI Agent Security: Multi-Step Tool Attacks",
    blurb:
      "Found a guardrail scope mismatch in a tool-using agent and exploited it at scale. Code, lab notebook and report on GitHub.",
    href: "https://github.com/Cpleasance/kaggle-ai-agent-security",
  },
  {
    label: "Kaggle · Gemma 4 Developer Agent Paper Track",
    title: "It Shouldn't Matter What Task Is Given",
    blurb: "A held-out task pool and a pre-flight suite.",
    href: "https://www.kaggle.com/competitions/gemma-4-developer-agent-paper/writeups/new-writeup-1794239936181",
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div class="my-4 flex items-center gap-4 sm:my-8 sm:gap-6">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}avatar.png`}
          alt="Pixel-art portrait of Cory at a computer"
          width="96"
          height="96"
          class="size-16 shrink-0 rounded-lg sm:size-24"
          style="image-rendering: pixelated"
        />
        <div>
          <h1 class="inline text-3xl font-bold sm:text-5xl">
            Hey there, I'm Cory
          </h1>{" "}
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>
          <p class="mt-2 text-sm opacity-75 sm:text-base">
            Third-year Data Science &amp; AI student, University of Stirling
          </p>
        </div>
      </div>

      <p>
        I write here about AI security, agent evaluation, and systems
        engineering.
      </p>

      <dl class="mt-6 grid gap-x-6 gap-y-1 sm:grid-cols-[auto_1fr] sm:gap-y-3">
        <dt class="text-accent font-semibold">Research</dt>
        <dd class="mb-3 sm:mb-0">
          Building multi-agent systems that red-team language models, and
          measuring how well the models hold up.
        </dd>
        <dt class="text-accent font-semibold">Teaching</dt>
        <dd class="mb-3 sm:mb-0">
          Demonstrator for Data Structures and Algorithms (CSCU9A3).
        </dd>
        <dt class="text-accent font-semibold">Next</dt>
        <dd>Technology Developer intern at Barclays UK, summer 2027.</dd>
      </dl>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
        {socials.length > 0 && <Socials />}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          More about me
        </LinkButton>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }

    <section
      id="work"
      class:list={[
        "pt-12 pb-8",
        { "border-border border-t": sortedPosts.length > 0 },
      ]}
    >
      <h2 class="text-2xl font-semibold tracking-wide">Selected work</h2>
      <ul
        class:list={["mt-6 grid gap-4", { "sm:grid-cols-2": work.length > 1 }]}
      >
        {
          work.map(item => (
            <li>
              <a
                href={item.href}
                class="border-border hover:border-accent group block h-full rounded-lg border p-4 transition-colors"
              >
                <p class="text-accent text-sm">{item.label}</p>
                <h3 class="group-hover:text-accent mt-1 font-semibold">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm opacity-80">{item.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6">
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "projects")}
        >
          All projects
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
